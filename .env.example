# Copy to .env for local overrides (Compose loads .env automatically).
POSTGRES_USER=pozpay
POSTGRES_PASSWORD=pozpay
POSTGRES_DB=pozpay
POSTGRES_PORT=5432

# Host-side URL (make run / make migrate against published port)
DATABASE_URL=postgres://pozpay:pozpay@localhost:5432/pozpay?sslmode=disable

# In-compose API → Postgres (service hostname)
DATABASE_URL_DOCKER=postgres://pozpay:pozpay@postgres:5432/pozpay?sslmode=disable

RABBITMQ_USER=pozpay
RABBITMQ_PASSWORD=pozpay
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Host-side broker (make run)
RABBITMQ_URL=amqp://pozpay:pozpay@localhost:5672/
# In-compose API uses amqp://pozpay:pozpay@rabbitmq:5672/

# CSV check-register upload cap, bytes. Default 64 MiB.
CHECK_REGISTER_MAX_UPLOAD_BYTES=67108864

API_PORT=8080
API_ADDR=:8080

# Copy to .env for local overrides (Compose loads .env automatically).
POSTGRES_USER=pozpay
POSTGRES_PASSWORD=pozpay
POSTGRES_DB=pozpay
POSTGRES_PORT=5432

# Host-side URL (make run / make migrate against published port)
DATABASE_URL=postgres://pozpay:pozpay@localhost:5432/pozpay?sslmode=disable

# In-compose API → Postgres (service hostname)
DATABASE_URL_DOCKER=postgres://pozpay:pozpay@postgres:5432/pozpay?sslmode=disable

API_PORT=8080
API_ADDR=:8080
